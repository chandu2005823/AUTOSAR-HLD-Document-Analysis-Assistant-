# Required in production. Store the real key only in the Render environment settings.
GROQ_API_KEY=your-groq-api-key

# Production must set a stable random secret (at least 32 bytes).
AUTOARCH_API_SECRET=replace-with-a-unique-random-value-of-at-least-32-characters
AUTOARCH_REQUIRE_API_SECRET=false

# Comma-separated exact browser origins. The default is local Vite development only.
AUTOARCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Storage defaults preserve the existing project-relative data/ layout.
AUTOARCH_DATA_DIR=data
# Optional per-store overrides; relative values resolve from the project root.
AUTOARCH_DB_PATH=data/processed/access_control.sqlite3
AUTOARCH_AUDIT_DB_PATH=data/processed/audit_log.sqlite3
AUTOARCH_CHROMA_DIR=data/chroma
AUTOARCH_PROCESSED_DIR=data/processed

# Per-PDF upload limit and OCR render resolution.
AUTOARCH_MAX_UPLOAD_MB=50
AUTOARCH_OCR_DPI=300
# Optional temporary upload directory; defaults to the system temp directory.
AUTOARCH_TEMP_DIR=

# Optional Hugging Face cache location for Sentence Transformers.
HF_HOME=data/model-cache

# Optional only when the Tesseract executable is not available on PATH.
TESSERACT_CMD=
